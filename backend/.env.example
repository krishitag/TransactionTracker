# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real keys.

# Local Postgres from docker-compose.yml (dev-only password, not a secret)
DATABASE_URL=postgresql://risk:risk_dev_password@localhost:5433/risk

# /ask LLM: "gemini" (default, free key from https://aistudio.google.com) or "claude"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional backup keys, each from a DIFFERENT Google project (quota is per project); used only on rate limits
GEMINI_API_KEY_2=
# Optional: GEMINI_MODEL=gemini-3.8-flash   GEMINI_THINKING=low (minimal | low | medium | high)

# Only needed with LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Browser origins allowed to call the API (comma-separated)
FRONTEND_ORIGINS=http://localhost:3100
